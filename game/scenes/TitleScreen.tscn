[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/TitleScreen.cs" id="1_title"]

[node name="TitleScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 48
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 48

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Reflets de Lignée"

[node name="Subtitle" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "Un clan, un miroir, des générations. Chaque partie est sauvegardée d'elle-même au début de chaque année."
autowrap_mode = 3

[node name="SeedRow" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SeedLabel" type="Label" parent="Margin/Layout/SeedRow"]
layout_mode = 2
text = "Graine du monde (facultative) :"

[node name="Seed" type="LineEdit" parent="Margin/Layout/SeedRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 0)
layout_mode = 2
placeholder_text = "au hasard"

[node name="Slots" type="VBoxContainer" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="Status" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3
