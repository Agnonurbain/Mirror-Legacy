<Project Sdk="Microsoft.NET.Sdk">

  <!-- Engine-free simulation of Reflets de Lignée: every game rule lives here and is tested with dotnet test. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MirrorChronicles.Core</AssemblyName>
    <RootNamespace>MirrorChronicles</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Saves: JSON with enums by name (SaveSerializer) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
